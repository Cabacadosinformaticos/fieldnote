{
  "expo": {
    "name": "Fieldnote",
    "slug": "fieldnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldnote",
    "userInterfaceStyle": "light",
    "android": {
      "package": "io.github.cabacadosinformaticos.fieldnote",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#EAF0FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6FB"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmara serve para ler o código QR do convite e para tirar fotografias ou vídeos pedidos pelo estudo.",
          "microphonePermission": "O microfone só é usado nos registos de áudio ou vídeo pedidos pelo estudo.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O microfone só é usado nos registos de áudio pedidos pelo estudo.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8080/api/v1"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
