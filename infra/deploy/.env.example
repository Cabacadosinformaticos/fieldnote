# Development values only. Copy to .env (gitignored) and change every secret outside development.

# API
FIELDNOTE_ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=fieldnote
POSTGRES_DB=fieldnote
POSTGRES_PASSWORD=fieldnote

# RabbitMQ
RABBITMQ_USER=fieldnote
RABBITMQ_PASSWORD=fieldnote

# Garage: RPC secret is 32 bytes in hex; the access key is GK plus 24 hex characters
GARAGE_RPC_SECRET=3f6b1c2d4e5a69788796a5b4c3d2e1f00112233445566778899aabbccddeeff0
GARAGE_ADMIN_TOKEN=dev-garage-admin-token
GARAGE_METRICS_TOKEN=dev-garage-metrics-token
GARAGE_ACCESS_KEY=GK0123456789abcdef01234567
GARAGE_SECRET_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_BUCKET=media

# Cluster profile only (compose.cluster.yaml)
RABBITMQ_ERLANG_COOKIE=fieldnote-cluster-cookie-dev
PATRONI_SUPERUSER_PASSWORD=patroni-superuser-dev
PATRONI_REPLICATION_PASSWORD=patroni-replication-dev
PATRONI_RESTAPI_PASSWORD=patroni-restapi-dev

# Monitoring and jobs
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=fieldnote-grafana-dev
ERASURE_JOB_INTERVAL_SECONDS=300
# Cluster profile only
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
