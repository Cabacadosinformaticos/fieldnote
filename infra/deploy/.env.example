# Garage: RPC secret is 32 bytes in hex; the access key is GK plus 24 hex characters
GARAGE_RPC_SECRET=3f6b1c2d4e5a69788796a5b4c3d2e1f00112233445566778899aabbccddeeff0
GARAGE_ADMIN_TOKEN=dev-garage-admin-token
GARAGE_METRICS_TOKEN=dev-garage-metrics-token
GARAGE_ACCESS_KEY=GK0123456789abcdef01234567
GARAGE_SECRET_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_BUCKET=media
